# Advanced ClearCraft Configuration Examples
# Copy sections to your .env file as needed

# ============================================================================
# HIGH PERFORMANCE CONFIGURATION
# ============================================================================
# Optimized for speed with reasonable quality

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Processing - Larger chunks, faster processing
CHUNK_SIZE=2000                     # 2x default for faster chunking
MAX_TEXT_LENGTH=100000              # Support larger documents

# Quality - Relaxed for speed
MAX_CHANGE_RATIO=0.35               # Allow more changes
SIMILARITY_MIN=0.88                 # Lower threshold
MAX_PASSIVE_RATIO=0.20              # More lenient
MAX_REPETITION_RATIO=0.15           # More lenient

# Readability - Wider range
TARGET_AVG_SENTENCE_LENGTH_MIN=12
TARGET_AVG_SENTENCE_LENGTH_MAX=25

# Models - Use smaller/faster models
SENTENCE_TRANSFORMER_MODEL=paraphrase-MiniLM-L3-v2  # Smaller, faster
SPACY_MODEL=en_core_web_sm                          # Already smallest

# Caching - Aggressive caching
TRANSFORMERS_CACHE=.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=.cache/sentence-transformers

# Privacy
ENABLE_DISCLOSURE=true
REDACT_PII_IN_LOGS=true
LOG_LEVEL=INFO


# ============================================================================
# HIGH QUALITY CONFIGURATION
# ============================================================================
# Optimized for maximum quality, slower processing

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Processing - Smaller chunks for precision
CHUNK_SIZE=500                      # Smaller chunks, more precise
MAX_TEXT_LENGTH=50000               # Conservative limit

# Quality - Strict for maximum quality
MAX_CHANGE_RATIO=0.25               # Fewer changes
SIMILARITY_MIN=0.95                 # Very high similarity requirement
MAX_PASSIVE_RATIO=0.10              # Strict passive voice limit
MAX_REPETITION_RATIO=0.05           # Strict repetition limit

# Readability - Tight control
TARGET_AVG_SENTENCE_LENGTH_MIN=15
TARGET_AVG_SENTENCE_LENGTH_MAX=20

# Models - Use best models
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-mpnet-base-v2  # More accurate
SPACY_MODEL=en_core_web_sm

# DeepInfra - Enable for premium quality
DEEPINFRA_API_TOKEN=your_token_here
DEEPINFRA_MODEL=anthropic/claude-3-7-sonnet  # Best quality

# Privacy
ENABLE_DISCLOSURE=true
REDACT_PII_IN_LOGS=true
LOG_LEVEL=INFO


# ============================================================================
# ACADEMIC WRITING CONFIGURATION
# ============================================================================
# Optimized for academic papers and research

# Processing
CHUNK_SIZE=1000
MAX_TEXT_LENGTH=75000               # Support longer papers

# Quality - Very strict to preserve academic rigor
MAX_CHANGE_RATIO=0.20               # Minimal changes
SIMILARITY_MIN=0.96                 # Preserve meaning strictly
PRESERVE_CITATIONS=true             # Critical for academic work

# Readability - Academic style
TARGET_AVG_SENTENCE_LENGTH_MIN=16   # Slightly longer sentences
TARGET_AVG_SENTENCE_LENGTH_MAX=24   # More complex acceptable
MAX_PASSIVE_RATIO=0.15              # Some passive OK in academic
MAX_REPETITION_RATIO=0.08           # Technical terms may repeat

# Models
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-mpnet-base-v2
SPACY_MODEL=en_core_web_sm

# DeepInfra - Use academic-tuned model
DEEPINFRA_MODEL=anthropic/claude-3-7-sonnet

# Privacy - Extra strict for research
ENABLE_DISCLOSURE=true              # Transparency required
REDACT_PII_IN_LOGS=true
LOG_LEVEL=WARNING                   # Minimal logging


# ============================================================================
# BUSINESS DOCUMENT CONFIGURATION
# ============================================================================
# Optimized for business communication

# Processing
CHUNK_SIZE=1000
MAX_TEXT_LENGTH=50000

# Quality - Balanced for business
MAX_CHANGE_RATIO=0.30
SIMILARITY_MIN=0.92
PRESERVE_CITATIONS=true

# Readability - Business clarity
TARGET_AVG_SENTENCE_LENGTH_MIN=14   # Clear and concise
TARGET_AVG_SENTENCE_LENGTH_MAX=20   # Avoid complexity
MAX_PASSIVE_RATIO=0.12              # Active voice preferred
MAX_REPETITION_RATIO=0.10           # Reduce jargon repetition

# Models
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# DeepInfra - Business-appropriate model
DEEPINFRA_MODEL=meta-llama/Llama-4-Maverick-17B

# Privacy
ENABLE_DISCLOSURE=true
REDACT_PII_IN_LOGS=true
LOG_LEVEL=INFO


# ============================================================================
# BLOG/CONTENT CREATION CONFIGURATION
# ============================================================================
# Optimized for blog posts and web content

# Processing
CHUNK_SIZE=800                      # Shorter chunks for variety
MAX_TEXT_LENGTH=50000

# Quality - More lenient for creativity
MAX_CHANGE_RATIO=0.35               # More changes OK
SIMILARITY_MIN=0.88                 # Allow more rewriting
PRESERVE_CITATIONS=true

# Readability - Maximum readability
TARGET_AVG_SENTENCE_LENGTH_MIN=12   # Short, punchy sentences
TARGET_AVG_SENTENCE_LENGTH_MAX=18   # Very readable
MAX_PASSIVE_RATIO=0.08              # Almost no passive
MAX_REPETITION_RATIO=0.05           # Vary language

# Models
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# DeepInfra - Conversational model
DEEPINFRA_MODEL=meta-llama/Llama-4-Maverick-17B

# Privacy
ENABLE_DISCLOSURE=true
REDACT_PII_IN_LOGS=true
LOG_LEVEL=INFO


# ============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# ============================================================================
# For development and debugging

# Server
HOST=127.0.0.1                      # Localhost only
PORT=8000
DEBUG=true                          # Enable debug mode

# Processing
CHUNK_SIZE=500                      # Smaller for testing
MAX_TEXT_LENGTH=10000               # Limit for quick tests

# Quality - Relaxed for testing
MAX_CHANGE_RATIO=0.40
SIMILARITY_MIN=0.85
PRESERVE_CITATIONS=true

# Readability - Defaults
TARGET_AVG_SENTENCE_LENGTH_MIN=14
TARGET_AVG_SENTENCE_LENGTH_MAX=22
MAX_PASSIVE_RATIO=0.15
MAX_REPETITION_RATIO=0.10

# Models - Smallest/fastest for dev
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# Caching - Use temp
TRANSFORMERS_CACHE=/tmp/clearcraft/huggingface
SENTENCE_TRANSFORMERS_HOME=/tmp/clearcraft/sentence-transformers

# Logging - Verbose
LOG_LEVEL=DEBUG
LOG_FILE=clearcraft-dev.log
ENABLE_DISCLOSURE=false             # Skip for testing
REDACT_PII_IN_LOGS=false            # See full logs


# ============================================================================
# PRODUCTION CONFIGURATION
# ============================================================================
# Secure, performant production setup

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false                         # Never true in production

# Processing
CHUNK_SIZE=1000
MAX_TEXT_LENGTH=50000

# Quality - Production defaults
MAX_CHANGE_RATIO=0.30
SIMILARITY_MIN=0.92
PRESERVE_CITATIONS=true

# Readability
TARGET_AVG_SENTENCE_LENGTH_MIN=14
TARGET_AVG_SENTENCE_LENGTH_MAX=22
MAX_PASSIVE_RATIO=0.15
MAX_REPETITION_RATIO=0.10

# Models
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# Caching - Persistent production cache
TRANSFORMERS_CACHE=/var/cache/clearcraft/huggingface
SENTENCE_TRANSFORMERS_HOME=/var/cache/clearcraft/sentence-transformers

# DeepInfra - From secrets manager
DEEPINFRA_API_TOKEN=${SECRET_DEEPINFRA_TOKEN}
DEEPINFRA_MODEL=meta-llama/Llama-4-Maverick-17B

# Security & Privacy
ENABLE_DISCLOSURE=true
REDACT_PII_IN_LOGS=true
LOG_LEVEL=WARNING                   # Errors and warnings only
LOG_FILE=/var/log/clearcraft/clearcraft.log

# Disallowed keywords (override if needed)
# Note: These are defaults, defined in config.py


# ============================================================================
# LOW RESOURCE CONFIGURATION
# ============================================================================
# For systems with limited RAM/CPU

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Processing - Conservative limits
CHUNK_SIZE=500                      # Smaller chunks
MAX_TEXT_LENGTH=10000               # Smaller docs only

# Quality - Relaxed to reduce processing
MAX_CHANGE_RATIO=0.35
SIMILARITY_MIN=0.88
PRESERVE_CITATIONS=true

# Readability
TARGET_AVG_SENTENCE_LENGTH_MIN=14
TARGET_AVG_SENTENCE_LENGTH_MAX=22
MAX_PASSIVE_RATIO=0.20
MAX_REPETITION_RATIO=0.15

# Models - Smallest possible
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# Don't use LLM (saves memory)
DEEPINFRA_API_TOKEN=

# Logging - Minimal
LOG_LEVEL=ERROR
ENABLE_DISCLOSURE=true
REDACT_PII_IN_LOGS=true


# ============================================================================
# BATCH PROCESSING CONFIGURATION
# ============================================================================
# For processing many documents

# Processing - Optimize for throughput
CHUNK_SIZE=2000                     # Larger chunks
MAX_TEXT_LENGTH=100000              # Support large batches

# Quality - Balanced
MAX_CHANGE_RATIO=0.30
SIMILARITY_MIN=0.90                 # Slightly relaxed for speed
PRESERVE_CITATIONS=true

# Readability
TARGET_AVG_SENTENCE_LENGTH_MIN=14
TARGET_AVG_SENTENCE_LENGTH_MAX=22
MAX_PASSIVE_RATIO=0.15
MAX_REPETITION_RATIO=0.10

# Models - Balance speed/quality
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Caching - Essential for batch
TRANSFORMERS_CACHE=/data/clearcraft/cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/data/clearcraft/cache/sentence-transformers

# Logging - Minimal for performance
LOG_LEVEL=WARNING
ENABLE_DISCLOSURE=true
REDACT_PII_IN_LOGS=true


# ============================================================================
# NOTES
# ============================================================================
#
# Model Size Comparison:
# - all-MiniLM-L6-v2:     ~80MB, 384 dimensions, fastest
# - all-mpnet-base-v2:    ~420MB, 768 dimensions, most accurate
# - paraphrase-MiniLM:    ~60MB, 384 dimensions, very fast
#
# Performance Tuning:
# - Smaller CHUNK_SIZE = More precise, slower
# - Larger CHUNK_SIZE = Faster, less precise
# - Lower SIMILARITY_MIN = More changes allowed
# - Higher SIMILARITY_MIN = Stricter meaning preservation
#
# Security:
# - Always use REDACT_PII_IN_LOGS=true in production
# - Store DEEPINFRA_API_TOKEN in secrets manager, not .env
# - Use LOG_LEVEL=WARNING or ERROR in production
# - Never set DEBUG=true in production
