# ClearCraft Configuration
# Copy this file to .env and configure your settings

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# DeepInfra API (Optional - leave empty to disable LLM pass)
# Get your API key from https://deepinfra.com
DEEPINFRA_API_TOKEN=

# DeepInfra Model Configuration
# See https://deepinfra.com/models for available models
# Examples:
#   - meta-llama/Llama-4-Maverick-17B
#   - anthropic/claude-3-7-sonnet
#   - Qwen/Qwen3-235B-Instruct
#   - microsoft/deepseek-v2
DEEPINFRA_MODEL=meta-llama/Llama-4-Maverick-17B

# Processing Limits
MAX_TEXT_LENGTH=50000
CHUNK_SIZE=1000

# Quality Guardrails
MAX_CHANGE_RATIO=0.30
SIMILARITY_MIN=0.92
PRESERVE_CITATIONS=true

# Readability Targets
TARGET_AVG_SENTENCE_LENGTH_MIN=14
TARGET_AVG_SENTENCE_LENGTH_MAX=22
MAX_PASSIVE_RATIO=0.15
MAX_REPETITION_RATIO=0.10

# Model Cache Directory
TRANSFORMERS_CACHE=.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=.cache/sentence-transformers

# Logging
LOG_LEVEL=INFO
LOG_FILE=clearcraft.log

# Privacy & Compliance
ENABLE_DISCLOSURE=true
REDACT_PII_IN_LOGS=true
